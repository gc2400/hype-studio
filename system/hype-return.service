[Unit]
Description=Hype live: music feed to the studio (MediaMTX return)
After=hype-pulse.service hype-mediamtx.service hype-radio.service
[Service]
Environment=XDG_RUNTIME_DIR=/run/hype
Environment=HOME=/root
ExecStart=/opt/hype/live/return.sh
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
