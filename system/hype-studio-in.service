[Unit]
Description=Hype live: studio mix into the radio (harbor)
After=hype-pulse.service hype-mediamtx.service hype-radio.service
[Service]
Environment=XDG_RUNTIME_DIR=/run/hype
Environment=HOME=/root
ExecStart=/opt/hype/live/studio_in.sh
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
